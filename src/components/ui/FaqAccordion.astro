---
import type { FaqItem } from '../../data/faq';

interface Props {
  items: FaqItem[];
  idPrefix?: string;
}

const { items, idPrefix = 'faq' } = Astro.props;
---

<div class="divide-y divide-bege border-t border-b border-bege">
  {items.map((item, idx) => (
    <details class="group py-5" id={`${idPrefix}-${idx + 1}`}>
      <summary class="flex items-start justify-between gap-4 cursor-pointer list-none font-serif text-xl sm:text-2xl text-bordo hover:text-bordo-escuro transition-colors">
        <span>{item.question}</span>
        <span
          aria-hidden="true"
          class="mt-1 shrink-0 w-7 h-7 border border-bordo/30 inline-flex items-center justify-center text-bordo text-lg leading-none transition-transform group-open:rotate-45"
        >
          +
        </span>
      </summary>
      <div class="pt-3.5 pr-8 text-base text-grafite/90 leading-relaxed">
        <p>{item.answer}</p>
      </div>
    </details>
  ))}
</div>
