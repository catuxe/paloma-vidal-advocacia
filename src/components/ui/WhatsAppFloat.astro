---
import { PROFESSIONAL } from '../../config/professional';
---

<a
  href={PROFESSIONAL.whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  data-track-event="contact_whatsapp_click"
  aria-label="Abrir conversa pelo WhatsApp profissional de Paloma Vidal"
  class="fixed bottom-5 right-5 z-40 inline-flex items-center gap-2.5 bg-bordo text-marfim border border-dourado/70 px-4 py-3 shadow-lg hover:bg-bordo-escuro hover:border-dourado transition-colors"
>
  <svg class="w-5 h-5 text-dourado shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
  </svg>
  <span class="text-sm font-medium tracking-wide hidden sm:inline">WhatsApp profissional</span>
</a>
