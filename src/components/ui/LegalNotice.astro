---
import { PROFESSIONAL } from '../../config/professional';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<aside
  aria-label="Aviso de caráter informativo"
  class:list={[
    'border-l-2 border-bordo bg-bege-claro/80 text-grafite',
    compact ? 'p-4 text-sm' : 'p-5 sm:p-6 text-sm sm:text-base',
  ]}
>
  <p class="font-semibold text-bordo text-xs uppercase tracking-widest mb-1.5">
    Aviso de caráter informativo
  </p>
  <p class="leading-relaxed text-grafite/90">
    {PROFESSIONAL.informativeDisclaimer} As regras previdenciárias e assistenciais podem sofrer atualizações
    legislativas, regulamentares e jurisprudenciais; a verificação do direito depende dos fatos e documentos de cada
    pessoa.
  </p>
</aside>
