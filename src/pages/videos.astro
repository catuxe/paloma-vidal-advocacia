---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import InstagramEmbed from '../components/videos/InstagramEmbed.astro';
import InstitutionalVideoPlayer from '../components/videos/InstitutionalVideoPlayer.astro';
import LegalNotice from '../components/ui/LegalNotice.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import { getPublishedVideos } from '../data/videos';
import { PROFESSIONAL } from '../config/professional';

const videos = getPublishedVideos();
---

<BaseLayout
  title={`Conteúdos em Vídeo sobre Direito Previdenciário | ${PROFESSIONAL.professionalName} | ${PROFESSIONAL.oab}`}
  description="Assista aos vídeos educativos de Paloma Vidal sobre Direito Previdenciário, BPC/LOAS, salário-maternidade e benefícios do INSS."
>
  <section class="bg-bordo text-marfim py-14 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'Vídeos' }]} dark={true} />
      <div class="max-w-3xl space-y-4">
        <p class="text-xs uppercase tracking-[0.22em] text-dourado font-medium">Instagram {PROFESSIONAL.instagramHandle}</p>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-marfim">Conteúdos em vídeo</h1>
        <p class="text-base sm:text-lg text-marfim/85 leading-relaxed">
          Seleção de vídeos informativos produzidos por Paloma Vidal sobre direitos previdenciários e assistenciais.
          Cada vídeo é carregado sob demanda para garantir rapidez e controle de privacidade.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-marfim py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      <div class="max-w-4xl space-y-4">
        <p class="text-xs uppercase tracking-[0.22em] text-dourado-escuro font-semibold">Vídeo principal</p>
        <h2 class="font-serif text-3xl sm:text-4xl text-bordo">Apresentação institucional</h2>
        <InstitutionalVideoPlayer />
      </div>

      <div class="space-y-6">
        <div class="flex items-center gap-4">
          <h2 class="font-serif text-3xl text-bordo shrink-0">Galeria de vídeos do Instagram</h2>
          <div class="h-px bg-bege flex-1" aria-hidden="true"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {videos.map((video) => (
            <InstagramEmbed video={video} />
          ))}
        </div>
      </div>

      <div class="bg-branco border border-bege p-7 sm:p-8 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
        <div class="space-y-1">
          <h2 class="font-serif text-2xl text-bordo">Acompanhe novos conteúdos no Instagram</h2>
          <p class="text-sm sm:text-base text-grafite-suave">
            Publicações regulares com orientações acessíveis sobre o INSS no perfil {PROFESSIONAL.instagramHandle}.
          </p>
        </div>
        <a
          href={PROFESSIONAL.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold bg-bordo text-marfim hover:bg-bordo-escuro transition-colors shrink-0"
        >
          Acessar Instagram oficial
        </a>
      </div>

      <LegalNotice />
    </div>
  </section>

  <ContactSection compact={true} />
</BaseLayout>
